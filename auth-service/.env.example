# === Copiez ce fichier en .env (non versionné) et remplissez vos valeurs locales ===

# ID du projet Firebase (public, pas sensible)
FIREBASE_PROJECT_ID=littlebook-b2d2d

# Chemin ABSOLU vers VOTRE clé de service locale (ne mettez pas votre vrai chemin ici !)
# Exemple macOS/Linux: /Users/vous/littlebook/secrets/firebase-sa.json
# Exemple Windows:     C:\Users\vous\littlebook\secrets\firebase-sa.json
FIREBASE_CREDENTIALS=/ABSOLU/vers/secrets/firebase-sa.json